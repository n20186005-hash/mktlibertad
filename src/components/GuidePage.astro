---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import data from '../data/guide.json';
import '../styles/global.css';
const {lang='es'}=Astro.props as {lang:'es'|'en'};const en=lang==='en',t=data.locales[lang],path=en?'/en/':'/';
const schema={'@context':'https://schema.org','@graph':[{'@type':'WebPage','@id':'https://mktlibertad.com'+path+'#page',url:'https://mktlibertad.com'+path,name:t.title,description:t.description,inLanguage:en?'en':'es-MX',about:{'@type':'Place',name:'Mercado Libertad (San Juan de Dios)',address:{'@type':'PostalAddress',addressLocality:'Guadalajara',addressRegion:'Jalisco',addressCountry:'MX',streetAddress:'C. Dionisio Rodríguez 52, San Juan de Dios',postalCode:'44360'},geo:{'@type':'GeoCoordinates',latitude:data.maps.latitude,longitude:data.maps.longitude}}},{'@type':'FAQPage',mainEntity:t.faq.map(([question,answer])=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}}))}]};
const navIds=['visita','historia','transporte','comida','cerca','faq','mapa'];const photo=data.photos[0];
---
<!doctype html><html lang={en?'en':'es-MX'}><head><BaseHead title={t.title} description={t.description} path={path} ogLocale={en?'en_US':'es_MX'} alternates={[{lang:'es-MX',href:'https://mktlibertad.com/'},{lang:'en',href:'https://mktlibertad.com/en/'},{lang:'x-default',href:'https://mktlibertad.com/'}]} /><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} /></head><body>
<a class="skip-link" href="#main">{en?'Skip to content':'Saltar al contenido'}</a>
<header class="site-header"><div class="wrap header-row"><a class="brand" href={path}><img src="/logo.svg" alt="Guía Mercado Libertad" width="225" height="60" /></a><a class="language" href={en?'/':'/en/'} lang={en?'es':'en'}>{en?'Español':'English'}</a></div><nav class="wrap main-nav" aria-label={en?'Main navigation':'Navegación principal'}>{t.nav.map((label,i)=><a href={'#'+navIds[i]}>{label}</a>)}</nav></header>
<main id="main"><section id="inicio" class="hero"><div class="wrap"><p class="eyebrow">Guadalajara · Jalisco · México</p><h1>Mercado Libertad <span>(San Juan de Dios)</span></h1><p class="intro">{t.intro}</p><p>{en?'Independent guide · Sources checked 20 October 2026':'Guía independiente · Fuentes consultadas el 20 de octubre de 2026'}</p><a class="button" href="#visita">{en?'Plan a visit':'Planear la visita'}</a><figure><img src={'/images/'+photo.name+'.webp'} width="1400" height="1050" alt={photo[lang]} fetchpriority="high" /><figcaption>{photo[lang]} · {photo.author} · {photo.date} · <a href={photo.source}>Wikimedia Commons</a> · <a href={photo.licenceUrl}>{photo.licence}</a> · {en?'Resized and converted to WebP. Historical image; access may differ today.':'Redimensionada y convertida a WebP. Imagen histórica; el acceso actual puede ser diferente.'}</figcaption></figure></div></section>
<div class="wrap content">{t.sections.map(([id,title,text])=><section id={id}><h2>{title}</h2><p>{text}</p>{id==='visita'&&<p class="note"><a href={data.sources[0].url}>{en?'Read the municipal tourism schedule':'Consultar el horario de Turismo municipal'}</a></p>}</section>)}
<section id="mapa"><h2>{en?'Location and map':'Ubicación y mapa'}</h2><p>{data.maps.address}</p><p>{en?'Google Maps place pin, checked 20 October 2026:':'Pin de la ficha de Google Maps, consultado el 20 de octubre de 2026:'} {data.maps.latitude}, {data.maps.longitude}. {en?'The listing address and pin are orientation references, not a confirmed visitor entrance.':'La dirección y el pin son referencias para orientarte, no una entrada de visitantes confirmada.'}</p><p>{en?'Google Maps snapshot, 20 October 2026: 4.4/5 from 92,713 reviews. This third-party rating can change; it is not a rating collected by this guide. The listing marks a wheelchair-accessible entrance, which is not an audit of all routes, levels or facilities. Ask locally about an appropriate route for your needs.':'Ficha de Google Maps, 20 de octubre de 2026: 4.4/5 y 92,713 reseñas. Esta valoración de terceros puede cambiar; no es una valoración recopilada por la guía. La ficha marca una entrada accesible en silla de ruedas; no es una auditoría de todas las rutas, niveles o instalaciones. Consulta una ruta adecuada a tus necesidades en el lugar.'}</p><a class="button" href="https://maps.app.goo.gl/Xe7gBQvxz4xU5teq8" rel="noopener noreferrer" target="_blank">{en?'Open Google Maps (external service)':'Abrir Google Maps (servicio externo)'}</a><p class="small">{en?'The map loads only when you follow the external link.':'El mapa se carga solo al seguir el enlace externo.'}</p></section>
<section id="faq"><h2>{en?'Frequently asked questions':'Preguntas frecuentes'}</h2>{t.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
<section id="galeria"><h2>{en?'Photographs with dates and credits':'Fotografías con fecha y créditos'}</h2><p>{en?'These dated images illustrate past views, not current shop inventory, access or services.':'Estas imágenes fechadas muestran vistas anteriores, no el inventario actual de comercios, accesos o servicios.'}</p><div class="gallery">{data.photos.slice(1).map(p=><figure><img src={'/images/'+p.name+'.webp'} width="900" height={p.name==='produce'?1600:p.name==='transit'?1200:675} alt={p[lang]} loading="lazy" /><figcaption>{p[lang]} · {p.author} · {p.date} · <a href={p.source}>Wikimedia Commons</a> · <a href={p.licenceUrl}>{p.licence}</a> · {en?'Resized / WebP':'Redimensionada / WebP'}</figcaption></figure>)}</div></section>
<section id="fuentes"><h2>{en?'Sources and verification limits':'Fuentes y límites de verificación'}</h2><p>{en?'Checked 20 October 2026. Sources describe different dates and scopes. Confirm day-specific trading and access locally. This site is not the market administration.':'Consultadas el 20 de octubre de 2026. Las fuentes describen fechas y ámbitos distintos. Confirma localmente la atención y el acceso del día. Este sitio no es la administración del mercado.'}</p><ul>{data.sources.map(s=><li><a href={s.url}>{s[lang]}</a></li>)}</ul><p><a href="https://maps.app.goo.gl/Xe7gBQvxz4xU5teq8">{en?'Google Maps: third-party place listing':'Google Maps: ficha de terceros del lugar'}</a></p></section></div></main>
<Footer lang={lang}/><aside id="cookie-banner" class="cookie-banner hidden" aria-label={en?'Analytics choice':'Elección de analítica'}><p>{en?'Optional Google Analytics stays off until you allow it. Your choice is stored in this browser.':'Google Analytics es opcional y permanece desactivado hasta que lo permitas. La elección se guarda en este navegador.'}</p><div><button data-cookie-reject>{en?'Reject analytics':'Rechazar analítica'}</button><button data-cookie-accept>{en?'Allow analytics':'Permitir analítica'}</button><a href="/cookies/">{en?'Settings (Spanish)':'Configurar'}</a></div><p data-consent-status aria-live="polite"></p></aside>
</body></html>
