---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import '../styles/global.css';
interface Props { title: string; description: string; path: string; }
const { title, description, path } = Astro.props;
---
<!doctype html><html lang="es-MX"><head><BaseHead title={title} description={description} path={path} /></head>
<body>
<header class="border-b border-[#d7c9b5] bg-[#fff9ef]">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-5 px-5 py-4">
    <a href="/" aria-label="Volver al inicio" class="focus-ring"><img src="/logo.svg" alt="Guía Mercado Libertad" class="h-12 w-auto" /></a>
    <a href="/" class="focus-ring rounded-full border border-[#9f3f2d] px-4 py-2 text-sm font-bold text-[#632719]">Volver a la guía</a>
  </div>
</header>
<main class="mx-auto max-w-3xl px-5 py-12 md:py-16">
  <slot />
</main>
<Footer />
</body></html>
