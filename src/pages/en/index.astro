---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const pageTitle = 'Mercado Libertad (San Juan de Dios) Guadalajara | Hours, map & visitor guide';
const description = 'Visit Mercado Libertad (San Juan de Dios) in Guadalajara: opening hours, how to get there by public transit, what to eat, crafts and an exact map. A free, independent visitor guide.';
const placeUrl = Astro.site ? new URL('/en/', Astro.site).toString() : undefined;
const imageUrl = Astro.site ? new URL('/images/hero.jpg', Astro.site).toString() : undefined;
const alternates = [
  { lang: 'es', href: new URL('/', Astro.site).toString() },
  { lang: 'en', href: new URL('/en/', Astro.site).toString() },
  { lang: 'x-default', href: new URL('/', Astro.site).toString() }
];

const touristSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'Mercado Libertad - San Juan de Dios',
  alternateName: 'Mercado San Juan de Dios',
  description,
  ...(placeUrl ? { url: placeUrl } : {}),
  ...(imageUrl ? { image: imageUrl } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'C. Dionisio Rodríguez 52, San Juan de Dios',
    postalCode: '44360',
    addressLocality: 'Guadalajara',
    addressRegion: 'Jalisco',
    addressCountry: 'MX'
  },
  geo: { '@type': 'GeoCoordinates', latitude: 20.6755148, longitude: -103.3424271 },
  openingHoursSpecification: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'].map((day) => ({
    '@type': 'OpeningHoursSpecification', dayOfWeek: `https://schema.org/${day}`, opens: '10:00', closes: '20:00'
  })),
  hasMap: 'https://www.google.com/maps/place/Mercado+Libertad+-+San+Juan+de+Dios/@20.6755148,-103.3424271,17z',
  sameAs: ['https://maps.app.goo.gl/Xe7gBQvxz4xU5teq8'],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.4', reviewCount: '92617', bestRating: '5' },
  isAccessibleForFree: true,
  publicAccess: true
};

const faqItems = [
  ['Is there a fee to enter Mercado Libertad?', 'General access to the market is free. Purchases, food, parking and other services are paid separately.'],
  ['What is the best time to visit?', 'The municipal tourism listing publishes hours of 10:00 to 20:00 every day. For a more comfortable visit, arrive in the morning or early afternoon and check for changes before you leave.'],
  ['How do I get there by public transport?', 'The San Juan de Dios station on Line 2 of the light rail (Tren Ligero) is right next to the market. Mi Macro Calzada and several urban bus routes also serve the Historic Center corridor.'],
  ['How much time should I plan for?', 'To see the architecture, walk the three levels and take a break to eat, plan between 1.5 and 3 hours. If architecture or shopping is your main interest, you can adjust the time.'],
  ['Are there restrooms and food options?', 'Yes, as a large public market it has restrooms and food areas. Availability, exact location and conditions can vary, so follow the interior signage.'],
  ['Is this an official market website?', 'No. This is an independent, educational, non-profit guide. For important travel decisions, confirm hours, works, access and services with official sources.']
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(([q,a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
};
---
<!doctype html>
<html lang="en">
<head>
  <BaseHead title={pageTitle} description={description} path="/en/" ogLocale="en_US" alternates={alternates} />
  <script type="application/ld+json" set:html={JSON.stringify(touristSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</head>
<body>
  <header class="sticky top-0 z-40 border-b border-[#6c2b1d]/20 bg-[#f5eedf]/95 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 md:px-6">
      <a href="#inicio" class="focus-ring shrink-0"><img src="/logo.svg" alt="Mercado Libertad Guide" class="h-11 w-auto md:h-13" /></a>
      <nav aria-label="Main navigation" class="hidden items-center gap-5 text-sm font-semibold lg:flex">
        <a href="#historia" class="hover:text-[#9f3f2d]">History</a><a href="#arquitectura" class="hover:text-[#9f3f2d]">Architecture</a><a href="#visita" class="hover:text-[#9f3f2d]">Plan your visit</a><a href="#transporte" class="hover:text-[#9f3f2d]">Transport</a><a href="#servicios" class="hover:text-[#9f3f2d]">Services</a><a href="#faq" class="hover:text-[#9f3f2d]">FAQ</a>
      </nav>
      <a href="/" hreflang="es" lang="es" class="focus-ring rounded-full border border-[#6c2b1d]/30 px-3 py-2 text-xs font-bold text-[#632719] hover:bg-[#632719] hover:text-white">ES</a>
      <a href="#mapa" class="focus-ring rounded-full bg-[#9f3f2d] px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-[#7f3022]">View map</a>
    </div>
  </header>

  <main>
    <section id="inicio" class="relative min-h-[78vh] overflow-hidden bg-[#221911] text-white">
      <img src="/images/hero.jpg" alt="Aerial view of the geometric roofs of Mercado Libertad" class="absolute inset-0 h-full w-full object-cover opacity-58" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#221911]/95 via-[#221911]/65 to-transparent"></div>
      <div class="roof-pattern absolute inset-0 opacity-30"></div>
      <div class="relative mx-auto flex min-h-[78vh] max-w-7xl items-end px-5 py-14 md:px-8 md:py-20">
        <div class="max-w-3xl">
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/25 bg-black/20 px-4 py-2 text-xs font-bold uppercase tracking-[.18em]">Artistic Monument · Guadalajara, Jalisco</div>
          <h1 class="font-display text-5xl leading-[.95] font-bold md:text-7xl">Mercado Libertad<br/><span class="text-[#f2c45f]">San Juan de Dios</span></h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-[#f3eadc] md:text-xl">A living market, a masterpiece of modern Tapatío architecture and a meeting point where commerce, food and urban memory meet under the roofs designed by Alejandro Zohn.</p>
          <div class="mt-8 flex flex-wrap gap-3 text-sm">
            <a href="#visita" class="focus-ring rounded-full bg-[#e4ad3f] px-5 py-3 font-extrabold text-[#221911]">Plan your visit</a>
            <a href="#historia" class="focus-ring rounded-full border border-white/40 bg-white/10 px-5 py-3 font-bold">Discover its history</a>
          </div>
        </div>
      </div>
    </section>

    <section class="market-grid border-b border-[#d8c7b2] bg-[#fff9ef]">
      <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-[#d8c7b2] md:grid-cols-4">
        <div class="bg-[#fff9ef] p-6"><div class="text-3xl font-bold text-[#9f3f2d]">1958</div><p class="mt-1 text-sm text-[#5a4a3d]">Year the current market opened, per Turismo Guadalajara.</p></div>
        <div class="bg-[#fff9ef] p-6"><div class="text-3xl font-bold text-[#9f3f2d]">3 levels</div><p class="mt-1 text-sm text-[#5a4a3d]">Groceries, prepared food, crafts and many other commercial lines.</p></div>
        <div class="bg-[#fff9ef] p-6"><div class="text-3xl font-bold text-[#9f3f2d]">2005</div><p class="mt-1 text-sm text-[#5a4a3d]">Declared an Artistic Monument of the Nation.</p></div>
        <div class="bg-[#fff9ef] p-6"><div class="text-3xl font-bold text-[#9f3f2d]">4.4 / 5</div><p class="mt-1 text-sm text-[#5a4a3d]">Rating shown by Google; it may change with new reviews.</p></div>
      </div>
    </section>

    <section id="historia" class="mx-auto max-w-7xl px-5 py-18 md:px-8 md:py-24">
      <div class="grid items-start gap-12 lg:grid-cols-[.9fr_1.1fr]">
        <div class="lg:sticky lg:top-24">
          <p class="text-sm font-extrabold uppercase tracking-[.22em] text-[#9f3f2d]">Urban history</p>
          <h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">A market born from the neighborhood</h2>
          <p class="mt-6 text-lg leading-8 text-[#55473b]">San Juan de Dios had a commercial vocation long before the current building. Municipal chronicles place a formal market in 1888; later came reconstructions, the piping of the old river, and in the 1950s the project that would turn the place into a reference point of Mexican public architecture.</p>
          <p class="mt-4 leading-8 text-[#55473b]">The current market was designed by Alejandro Zohn. The project understood the market not as a closed box, but as an ordered version of the tianguis: courtyards, ramps, crossed sightlines, connected levels and a roof that lets light in between structural forms.</p>
        </div>
        <div class="space-y-5">
          <article class="rounded-[2rem] bg-[#632719] p-7 text-white md:p-9"><span class="text-sm font-bold text-[#f2c45f]">1888</span><h3 class="mt-2 text-2xl font-bold">First formal Mercado Libertad</h3><p class="mt-3 leading-7 text-[#ead9cb]">Municipal documentation recalls the construction of a first market to organize the intense commercial activity of the San Juan de Dios area.</p></article>
          <article class="rounded-[2rem] border border-[#d4c0a7] bg-[#fff9ef] p-7 md:p-9"><span class="text-sm font-bold text-[#9f3f2d]">1920s</span><h3 class="mt-2 text-2xl font-bold">A new stage for the neighborhood</h3><p class="mt-3 leading-7 text-[#55473b]">The old market was replaced and the channel running along present-day Calzada Independencia was piped, changing forever the relationship between commerce, mobility and public space.</p></article>
          <article class="rounded-[2rem] bg-[#335b4a] p-7 text-white md:p-9"><span class="text-sm font-bold text-[#f2c45f]">1958–1959</span><h3 class="mt-2 text-2xl font-bold">The work of Alejandro Zohn</h3><p class="mt-3 leading-7 text-[#e4eee8]">The new Mercado Libertad opened in late 1958. INBAL documents its relevance for the use of exposed concrete, regional materials and hyperbolic paraboloids, with a great triple-height central hall.</p></article>
          <article class="rounded-[2rem] border border-[#d4c0a7] bg-[#fff9ef] p-7 md:p-9"><span class="text-sm font-bold text-[#9f3f2d]">2005</span><h3 class="mt-2 text-2xl font-bold">Artistic Monument</h3><p class="mt-3 leading-7 text-[#55473b]">The Government of Mexico declared the building an Artistic Monument for its aesthetic value, structural innovation and role in Mexican architecture oriented to public service.</p></article>
        </div>
      </div>
    </section>

    <section id="arquitectura" class="overflow-hidden bg-[#221911] py-18 text-white md:py-24">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="grid gap-10 lg:grid-cols-[1.1fr_.9fr] lg:items-center">
          <div class="overflow-hidden rounded-[2rem]"><img src="/images/interior.jpg" alt="Panorama of the interior of Mercado Libertad with its concrete structure" class="h-full min-h-[420px] w-full object-cover" loading="lazy" /></div>
          <div>
            <p class="text-sm font-extrabold uppercase tracking-[.22em] text-[#f2c45f]">What to look at</p>
            <h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">The architecture is also walked</h2>
            <p class="mt-6 text-lg leading-8 text-[#ded2c0]">INBAL highlights the innovation of its hyperbolic paraboloids, the exposed concrete and the use of regional materials such as glazed clay. The building blends circulation, structure and daily life in a way that is still understood by walking through it.</p>
            <div class="mt-8 grid gap-4 sm:grid-cols-2">
              <div class="rounded-2xl border border-white/15 p-5"><div class="text-2xl">△</div><h3 class="mt-2 font-bold">Folded roofs</h3><p class="mt-2 text-sm leading-6 text-[#cfc1b0]">Notice the geometric repetition and how triangles of light appear between the structural mantles.</p></div>
              <div class="rounded-2xl border border-white/15 p-5"><div class="text-2xl">↗</div><h3 class="mt-2 font-bold">Ramps and sightlines</h3><p class="mt-2 text-sm leading-6 text-[#cfc1b0]">The routes let you see several levels at once and read the market as a small indoor city.</p></div>
              <div class="rounded-2xl border border-white/15 p-5"><div class="text-2xl">▦</div><h3 class="mt-2 font-bold">Modulation</h3><p class="mt-2 text-sm leading-6 text-[#cfc1b0]">The structural grid organizes the stalls without erasing the spontaneous character of the popular market.</p></div>
              <div class="rounded-2xl border border-white/15 p-5"><div class="text-2xl">◫</div><h3 class="mt-2 font-bold">Courtyards and steps</h3><p class="mt-2 text-sm leading-6 text-[#cfc1b0]">The open spaces recover the plaza tradition and help connect interior and exterior.</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-18 md:px-8 md:py-24">
      <div class="grid gap-8 md:grid-cols-3">
        <div class="md:col-span-3"><p class="text-sm font-extrabold uppercase tracking-[.22em] text-[#9f3f2d]">How to read the market</p><h2 class="mt-3 font-display text-4xl font-bold">Three levels, many layers of Guadalajara</h2></div>
        <article class="rounded-[2rem] bg-[#fff9ef] p-7 shadow-[0_12px_40px_rgba(71,45,25,.08)]"><span class="text-xs font-black tracking-[.2em] text-[#9f3f2d]">LEVEL 01</span><h3 class="mt-3 text-2xl font-bold">Supply and color</h3><p class="mt-3 leading-7 text-[#55473b]">Fruit, vegetables, typical sweets, everyday goods and crafts. This is the level where the rhythm of the wholesale market is best perceived.</p></article>
        <article class="rounded-[2rem] bg-[#e4ad3f] p-7"><span class="text-xs font-black tracking-[.2em] text-[#632719]">LEVEL 02</span><h3 class="mt-3 text-2xl font-bold">Tapatío cuisine</h3><p class="mt-3 leading-7 text-[#493313]">Prepared-food areas with traditional dishes and antojitos. For a neutral guide, choose by visible hygiene, food rotation and posted prices.</p></article>
        <article class="rounded-[2rem] bg-[#335b4a] p-7 text-white"><span class="text-xs font-black tracking-[.2em] text-[#f2c45f]">LEVEL 03</span><h3 class="mt-3 text-2xl font-bold">Diverse commerce</h3><p class="mt-3 leading-7 text-[#e4eee8]">Clothing, footwear, leather goods, electronics and other lines. Inventory changes over time and is part of the dynamic character of the place.</p></article>
      </div>
      <figure class="mt-10 grid gap-5 md:grid-cols-[.7fr_1.3fr] md:items-stretch"><img src="/images/produce.jpg" alt="Fruit and piñatas in a hallway of Mercado San Juan de Dios" class="h-[420px] w-full rounded-[2rem] object-cover" loading="lazy" /><img src="/images/patio.jpg" alt="Interior courtyard and brick facades of Mercado Libertad" class="h-[420px] w-full rounded-[2rem] object-cover" loading="lazy" /></figure>
    </section>

    <section id="visita" class="bg-[#fff9ef] py-18 md:py-24">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <p class="text-sm font-extrabold uppercase tracking-[.22em] text-[#9f3f2d]">Plan your visit</p><h2 class="mt-3 max-w-3xl font-display text-4xl font-bold md:text-5xl">Practical information, without selling you anything</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-3xl border border-[#d8c7b2] p-6"><div class="text-2xl">◷</div><h3 class="mt-3 font-bold">Published hours</h3><p class="mt-2 text-sm leading-6 text-[#5b4c40]">10:00–20:00, every day, per Turismo Guadalajara. Check for changes on holidays, maintenance or events.</p></div>
          <div class="rounded-3xl border border-[#d8c7b2] p-6"><div class="text-2xl">$</div><h3 class="mt-3 font-bold">Entry and expenses</h3><p class="mt-2 text-sm leading-6 text-[#5b4c40]">General access is free. Purchases, food, parking and services are paid separately.</p></div>
          <div class="rounded-3xl border border-[#d8c7b2] p-6"><div class="text-2xl">☀</div><h3 class="mt-3 font-bold">Best moment</h3><p class="mt-2 text-sm leading-6 text-[#5b4c40]">Morning or early afternoon to have time and avoid arriving near closing. Weekends tend to feel more intense.</p></div>
          <div class="rounded-3xl border border-[#d8c7b2] p-6"><div class="text-2xl">⌛</div><h3 class="mt-3 font-bold">Suggested duration</h3><p class="mt-2 text-sm leading-6 text-[#5b4c40]">Between 1.5 and 3 hours to walk the levels, observe the architecture and eat at a relaxed pace.</p></div>
        </div>
        <div class="mt-8 rounded-[2rem] bg-[#f0e2cb] p-7 md:p-9"><h3 class="text-xl font-bold">Responsible visit tip</h3><p class="mt-3 max-w-4xl leading-8 text-[#55473b]">It is an active market, not a museum. Keep aisles clear, ask permission before photographing people or stalls up close, take care of your belongings in crowded areas and avoid blocking loading areas, stairs or ramps.</p></div>
      </div>
    </section>

    <section id="transporte" class="mx-auto max-w-7xl px-5 py-18 md:px-8 md:py-24">
      <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
        <div><p class="text-sm font-extrabold uppercase tracking-[.22em] text-[#9f3f2d]">Detailed transport</p><h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">Get there without complicating the Center</h2><p class="mt-5 leading-8 text-[#55473b]">The market is in one of the best-connected areas of downtown Guadalajara. Because of traffic and parking demand, public transport is usually the most predictable option.</p><img src="/images/transit.jpg" alt="Sign of the San Juan de Dios station of the SITEUR system" class="mt-7 h-80 w-full rounded-[2rem] object-cover" loading="lazy" /></div>
        <div class="space-y-4">
          <article class="rounded-3xl border border-[#d4c0a7] p-6"><h3 class="text-xl font-bold">✈ From Guadalajara International Airport (GDL)</h3><p class="mt-3 leading-7 text-[#55473b]">The airport is south of the city. GAP lists authorized taxi, shuttle, public transport and other ground options. By taxi or car, time depends on traffic; the terminal itself estimates about 35 minutes between downtown and the airport under normal conditions.</p><p class="mt-2 text-sm leading-6 text-[#78685a]">For bus or shuttle, confirm the current route and stop to the Historic Center at the terminal. From downtown, combine with Line 2 or Mi Macro Calzada for the final stretch.</p></article>
          <article class="rounded-3xl border border-[#d4c0a7] p-6"><h3 class="text-xl font-bold">🚇 Light rail</h3><p class="mt-3 leading-7 text-[#55473b]">The <strong>San Juan de Dios</strong> station on Line 2 is next to the market. It is the simplest reference for those already connected to the SITEUR network.</p></article>
          <article class="rounded-3xl border border-[#d4c0a7] p-6"><h3 class="text-xl font-bold">🚌 Bus and BRT</h3><p class="mt-3 leading-7 text-[#55473b]">Mi Macro Calzada runs along the Calzada Independencia corridor and there are urban bus routes in the Historic Center. Routes may change; check the official mobility planner before leaving.</p></article>
          <article class="rounded-3xl border border-[#d4c0a7] p-6"><h3 class="text-xl font-bold">🚕 Taxi and ride apps</h3><p class="mt-3 leading-7 text-[#55473b]">Request drop-off at a legal and safe point around the market perimeter, avoiding exclusive lanes and loading zones. From the airport, use the authorized points indicated by the terminal.</p></article>
          <article class="rounded-3xl border border-[#d4c0a7] p-6"><h3 class="text-xl font-bold">🚶 Walking and cycling</h3><p class="mt-3 leading-7 text-[#55473b]">From Plaza Tapatía, Museo Cabañas and the surroundings of Teatro Degollado you can walk. Turismo Guadalajara also integrates the center into its public bike network; on very busy streets it is best to get off the bike and walk.</p></article>
        </div>
      </div>
    </section>

    <section id="servicios" class="bg-[#335b4a] py-18 text-white md:py-24">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <p class="text-sm font-extrabold uppercase tracking-[.22em] text-[#f2c45f]">Services that usually matter to travelers</p><h2 class="mt-3 max-w-3xl font-display text-4xl font-bold md:text-5xl">What you can sort out in the area</h2>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {[
            ['Restrooms', 'There are restrooms in the complex; follow signage and consider there may be fees or their own hours.'],
            ['Parking', 'The market has parking areas and the municipality registers associated infrastructure. Capacity and rates may vary; do not rely on finding a spot at peak hour.'],
            ['Food', 'Inside the market you will find fondas, antojitos and drinks. Choose neutrally by visible cleanliness, food handling, clear prices and dietary preferences.'],
            ['Accessibility', 'The building uses ramps and circulations between levels, but it is a very crowded historic construction. For specific needs, confirm available access and elevators before the visit.'],
            ['Lodging', 'The Historic Center offers hotels, hostels and accommodations of different categories. Compare location, accessibility, noise, cancellation policies and nighttime transport.'],
            ['Daily shopping', 'In the central area there are convenience stores, pharmacies and supply businesses. This guide does not recommend specific establishments.'],
            ['Fuel and charging', 'Gas stations and vehicle charging points are better concentrated outside the streets immediately around the market. Plan a stop before entering the Historic Center.'],
            ['Cash and payments', 'Payment methods may vary between stalls. Carry an alternative payment method and avoid displaying large amounts of cash in crowded areas.']
          ].map(([title, text]) => <article class="rounded-3xl border border-white/15 bg-white/5 p-6"><h3 class="text-xl font-bold text-[#f2c45f]">{title}</h3><p class="mt-3 text-sm leading-7 text-[#e0ebe5]">{text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-18 md:px-8 md:py-24">
      <div class="grid gap-10 lg:grid-cols-2">
        <div><p class="text-sm font-extrabold uppercase tracking-[.22em] text-[#9f3f2d]">Food around</p><h2 class="mt-3 font-display text-4xl font-bold">Tapatío flavors, without a commercial ranking</h2><p class="mt-5 leading-8 text-[#55473b]">Food is part of the market experience. Instead of recommending specific businesses, these are representative categories and preparations you can look for by comparing hygiene, visible price and personal preferences.</p><div class="mt-6 flex flex-wrap gap-3">{['Tortas ahogadas','Birria','Tacos','Pozole','Carne en su jugo','Natural juices','Jericalla','Tejuino'].map((x) => <span class="rounded-full border border-[#c8b49a] bg-[#fff9ef] px-4 py-2 text-sm font-semibold">{x}</span>)}</div></div>
        <div><p class="text-sm font-extrabold uppercase tracking-[.22em] text-[#9f3f2d]">What to see nearby</p><h2 class="mt-3 font-display text-4xl font-bold">Continue through the Historic Center</h2><div class="mt-6 space-y-3">
          <div class="rounded-2xl bg-[#f0e2cb] p-5"><strong>Museo Cabañas</strong><p class="mt-1 text-sm leading-6 text-[#5d4d40]">World Heritage and one of the main cultural venues of the center, a short distance from the market.</p></div>
          <div class="rounded-2xl bg-[#f0e2cb] p-5"><strong>Plaza Tapatía</strong><p class="mt-1 text-sm leading-6 text-[#5d4d40]">Pedestrian corridor connecting the San Juan de Dios area with plazas and civic buildings.</p></div>
          <div class="rounded-2xl bg-[#f0e2cb] p-5"><strong>Teatro Degollado</strong><p class="mt-1 text-sm leading-6 text-[#5d4d40]">Guadalajara neoclassical landmark and a natural point to continue an architecture and history walk.</p></div>
          <div class="rounded-2xl bg-[#f0e2cb] p-5"><strong>Cathedral and Cruz de Plazas</strong><p class="mt-1 text-sm leading-6 text-[#5d4d40]">Set of civic and religious plazas that helps read the urban evolution of the heart of Guadalajara.</p></div>
        </div></div>
      </div>
    </section>

    <section id="mapa" class="bg-[#632719] py-18 text-white md:py-24">
